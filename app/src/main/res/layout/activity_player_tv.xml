<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:hide_on_touch="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:show_timeout="0"
        app:use_controller="false" />

    <FrameLayout
        android:id="@+id/player_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:id="@+id/main_load"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/player_loading_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="80dp"
            android:gravity="center"
            android:textColor="@color/grayTextColor"
            android:textSize="15sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/player_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/player_gradient_tv"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="24dp"
        android:paddingEnd="40dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/player_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@android:color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="Titolo" />

        <TextView
            android:id="@+id/player_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            tools:text="S1E1 • StreamingCommunity" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/player_gradient_tv"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="20dp"
        android:paddingEnd="40dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/player_play_pause"
                style="@style/VideoButtonTV"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/play"
                app:icon="@drawable/ic_baseline_play_arrow_24"
                app:iconSize="26dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/player_rewind"
                style="@style/VideoButtonTV"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Indietro 10s"
                app:icon="@drawable/ic_baseline_replay_10_24"
                app:iconSize="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/player_forward"
                style="@style/VideoButtonTV"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Avanti 10s"
                app:icon="@drawable/ic_baseline_forward_10_24"
                app:iconSize="24dp" />

            <TextView
                android:id="@+id/player_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                tools:text="00:00" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@+id/player_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:bar_height="4dp"
                app:buffered_color="#66FFFFFF"
                app:played_color="#FFFFFF"
                app:scrubber_color="#FFFFFF"
                app:unplayed_color="#4DFFFFFF" />

            <TextView
                android:id="@+id/player_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                tools:text="00:00" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/player_sources"
                style="@style/VideoButtonTV"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="18dp"
                android:text="@string/player_sources"
                app:icon="@drawable/ic_baseline_tune_24"
                app:iconSize="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/player_next"
                style="@style/VideoButtonTV"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/player_next"
                app:icon="@drawable/ic_baseline_skip_next_24"
                app:iconSize="24dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
